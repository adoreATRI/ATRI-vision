<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>usb_camera</name>
  <version>1.1.0</version>
  <description>
    USB camera package using L4V2 interface
    Capture video in JPEG format with reconnection support.
    publishe the usb_camera/image_compressed and usb_camera/camera_info topics.
  </description>
  <maintainer email="makochishima043@gmail.com">adore</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <depend>sensor_msgs</depend>
  
  <depend>camera_info_manager</depend>
  
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
